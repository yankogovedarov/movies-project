package templates

import (
	"strconv"

	"github.com/yankogovedarov/movie-tracker/internal/db"
)

templ MediaRow(m db.Medium) {
	<tr>
		<td class="filename">
			<form
				action={ templ.SafeURL("/media/" + strconv.FormatInt(m.ID, 10) + "/start") }
				method="POST"
				hx-post={ "/media/" + strconv.FormatInt(m.ID, 10) + "/start" }
				hx-target="closest tr"
				hx-swap="outerHTML"
			>
				<button type="submit" class="filename-link" title={ m.Filename }>{ m.Filename }</button>
			</form>
		</td>
		<td class="folder">
			<a
				href={ templ.SafeURL("/media/" + strconv.FormatInt(m.ID, 10) + "/open-folder") }
				hx-get={ "/media/" + strconv.FormatInt(m.ID, 10) + "/open-folder" }
				hx-swap="none"
				class="folder-link"
				title={ m.FolderRelativePath }
			>{ m.FolderRelativePath }</a>
		</td>
		<td class="size">{ formatSize(m.FileSizeBytes) }</td>
		<td class="status"><span class={ "status-" + statusClass(m.CurrentStatus) }>{ statusShort(m.CurrentStatus) }</span></td>
		<td class="actions">
			<div class="actions-grid">
				<form
					action={ templ.SafeURL("/media/" + strconv.FormatInt(m.ID, 10) + "/status") }
					method="POST"
					hx-post={ "/media/" + strconv.FormatInt(m.ID, 10) + "/status" }
					hx-target="closest tr"
					hx-swap="outerHTML"
				>
					<input type="hidden" name="status" value="new"/>
					<button type="submit" class="icon-btn" title="Нова">○</button>
				</form>
				<form
					action={ templ.SafeURL("/media/" + strconv.FormatInt(m.ID, 10) + "/status") }
					method="POST"
					hx-post={ "/media/" + strconv.FormatInt(m.ID, 10) + "/status" }
					hx-target="closest tr"
					hx-swap="outerHTML"
				>
					<input type="hidden" name="status" value="started"/>
					<button type="submit" class="icon-btn" title="Стартирана">▶</button>
				</form>
				<form
					action={ templ.SafeURL("/media/" + strconv.FormatInt(m.ID, 10) + "/status") }
					method="POST"
					hx-post={ "/media/" + strconv.FormatInt(m.ID, 10) + "/status" }
					hx-target="closest tr"
					hx-swap="outerHTML"
				>
					<input type="hidden" name="status" value="completed_both"/>
					<button type="submit" class="icon-btn" title="Завършена (двамата)">✓</button>
				</form>
				<form
					action={ templ.SafeURL("/media/" + strconv.FormatInt(m.ID, 10) + "/status") }
					method="POST"
					hx-post={ "/media/" + strconv.FormatInt(m.ID, 10) + "/status" }
					hx-target="closest tr"
					hx-swap="outerHTML"
				>
					<input type="hidden" name="status" value="completed_yanko"/>
					<button type="submit" class="icon-btn" title="Завършена (Янко)">Я</button>
				</form>
				<form
					action={ templ.SafeURL("/media/" + strconv.FormatInt(m.ID, 10) + "/status") }
					method="POST"
					hx-post={ "/media/" + strconv.FormatInt(m.ID, 10) + "/status" }
					hx-target="closest tr"
					hx-swap="outerHTML"
				>
					<input type="hidden" name="status" value="completed_liza"/>
					<button type="submit" class="icon-btn" title="Завършена (Лиза)">Л</button>
				</form>
				<a href={ templ.SafeURL("/media/" + strconv.FormatInt(m.ID, 10)) } class="icon-btn" title="Детайли">ℹ</a>
			</div>
		</td>
	</tr>
}

templ ListPage(media []db.Medium) {
	<!DOCTYPE html>
	<html lang="bg">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Movie Tracker</title>
			<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.min.css"/>
			<script src="https://unpkg.com/htmx.org@1.9.12"></script>
			<style>
				.top-nav { display: flex; align-items: center; gap: 0.8rem; padding: 0.2rem 0; margin-bottom: 0.5rem; border-bottom: 1px solid var(--pico-muted-border-color); flex-wrap: wrap; }
				.top-nav h1 { margin: 0; font-size: 1rem; flex: 0 0 auto; }
				.top-nav form { margin: 0; }
				.top-nav a, .top-nav button { margin: 0; padding: 0.2rem 0.6rem; font-size: 0.85rem; }
				.status-new { color: var(--pico-muted-color); }
				.status-started { color: var(--pico-color-amber-500, #f59e0b); }
				.status-completed { color: var(--pico-color-green-500, #22c55e); }
				table { width: 100%; table-layout: fixed; }
				td, th { vertical-align: middle; padding: 0.15rem 0.3rem; font-size: 0.85rem; }
				th.filename, td.filename { width: 35%; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
				th.folder,   td.folder   { width: 25%; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
				th.size,     td.size     { width: 5rem; white-space: nowrap; }
				th.status,   td.status   { width: 5rem; white-space: nowrap; }
				th.actions,  td.actions  { width: auto; white-space: nowrap; }
				form { display: inline; margin: 0; }
				button.filename-link {
					background: none; border: none; padding: 0;
					color: var(--pico-primary); cursor: pointer;
					text-decoration: underline; font: inherit; font-size: 0.85rem;
					text-align: left; white-space: nowrap;
					overflow: hidden; text-overflow: ellipsis;
					display: block; width: 100%;
				}
				a.folder-link {
					display: block; width: 100%;
					white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
					font-size: 0.85rem;
				}
				.actions-grid { display: flex; flex-wrap: nowrap; gap: 0.15rem; align-items: center; }
				button.icon-btn, a.icon-btn {
					display: inline-flex; align-items: center; justify-content: center;
					width: 1.6rem; height: 1.6rem; padding: 0;
					font-size: 0.8rem; border-radius: 3px; cursor: pointer;
					text-decoration: none; line-height: 1; flex-shrink: 0;
				}
				a.icon-btn {
					background: var(--pico-secondary-background, #f0f0f0);
					color: var(--pico-secondary-inverse, #333);
					border: 1px solid var(--pico-muted-border-color, #ccc);
				}
				@media (max-width: 768px) {
					th.size, td.size, th.folder, td.folder { display: none; }
					th.filename, td.filename { width: 55%; }
				}
			</style>
		</head>
		<body>
			<main class="container">
				<nav class="top-nav">
					<h1>Movie Tracker</h1>
					<a href="/">Списък</a>
					<a href="/tree">Дърво</a>
					<form method="POST" action="/scan">
						<button type="submit">Сканирай</button>
					</form>
				</nav>
				if len(media) == 0 {
					<p>Няма намерени медии на диска.</p>
				} else {
					<figure>
						<table>
							<thead>
								<tr>
									<th class="filename">Файл</th>
									<th class="folder">Папка</th>
									<th class="size">Размер</th>
									<th class="status">Статус</th>
									<th class="actions">Функции</th>
								</tr>
							</thead>
							<tbody>
								for _, m := range media {
									@MediaRow(m)
								}
							</tbody>
						</table>
					</figure>
				}
			</main>
		</body>
	</html>
}
