package templates

import (
	"strconv"

	"github.com/yankogovedarov/movie-tracker/internal/db"
)

templ ListPage(media []db.Medium) {
	<!DOCTYPE html>
	<html lang="bg">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Movie Tracker</title>
			<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.min.css"/>
			<style>
				.status-new { color: var(--pico-muted-color); }
				.status-started { color: var(--pico-color-amber-500, #f59e0b); }
				.status-completed { color: var(--pico-color-green-500, #22c55e); }
				button[type=submit] { padding: 0.25rem 0.75rem; margin: 0; }
				select { margin: 0; padding: 0.25rem; }
				table { width: 100%; table-layout: auto; }
				td, th { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
				td.filename, th.filename { max-width: 250px; white-space: normal; }
				td.folder, th.folder { display: none; }
				td.actions { white-space: normal; overflow: visible; }
				form { display: inline; margin: 0; }
				select { min-width: 150px; }
				@media (max-width: 1200px) {
					td.size, th.size { display: none; }
					td.filename { max-width: 200px; }
				}
				@media (max-width: 768px) {
					td.status, th.status { font-size: 0.9rem; }
					td.filename { max-width: 150px; }
				}
			</style>
		</head>
		<body>
			<main class="container">
				<h1>Movie Tracker</h1>
				if len(media) == 0 {
					<p>Няма намерени медии на диска.</p>
				} else {
					<figure>
						<table>
							<thead>
								<tr>
									<th class="filename">Файл</th>
									<th class="folder">Папка</th>
									<th class="size">Размер</th>
									<th class="status">Статус</th>
									<th class="actions"></th>
									<th class="actions"></th>
								</tr>
							</thead>
							<tbody>
								for _, m := range media {
									<tr>
										<td class="filename" title={ m.Filename }>{ m.Filename }</td>
										<td class="folder" title={ m.FolderRelativePath }>{ m.FolderRelativePath }</td>
										<td class="size">{ formatSize(m.FileSizeBytes) }</td>
										<td class="status"><span class={ "status-" + statusClass(m.CurrentStatus) }>{ m.CurrentStatus }</span></td>
										<td class="actions">
											<form method="POST" action={ templ.SafeURL("/media/" + strconv.FormatInt(m.ID, 10) + "/start") }>
												<button type="submit">Пусни</button>
											</form>
										</td>
										<td class="actions">
											<form method="POST" action={ templ.SafeURL("/media/" + strconv.FormatInt(m.ID, 10) + "/status") }>
												<select name="status">
													<option value="new">Нова</option>
													<option value="started">Стартирана</option>
													<option value="completed_both">Завършена (двамата)</option>
													<option value="completed_yanko">Завършена (Янко)</option>
													<option value="completed_liza">Завършена (Лиза)</option>
												</select>
												<button type="submit">Смени</button>
											</form>
										</td>
									</tr>
								}
							</tbody>
						</table>
					</figure>
				}
			</main>
		</body>
	</html>
}
