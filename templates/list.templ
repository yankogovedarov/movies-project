package templates

import (
	"strconv"

	"github.com/yankogovedarov/movie-tracker/internal/db"
)

templ MediaRow(m db.MediaWithStats) {
	<tr id={ "media-" + strconv.FormatInt(m.ID, 10) }>
		@mediaRowCells(m)
	</tr>
}

templ MediaRowOOB(m db.MediaWithStats) {
	<tr id={ "media-" + strconv.FormatInt(m.ID, 10) } hx-swap-oob="true">
		@mediaRowCells(m)
	</tr>
}

// Flash renders a short status message into the #flash region (templ auto-escapes msg).
templ Flash(msg string) {
	<span>{ msg }</span>
}

templ mediaRowCells(m db.MediaWithStats) {
		<td class="filename">
			<form
				action={ templ.SafeURL("/media/" + strconv.FormatInt(m.ID, 10) + "/start") }
				method="POST"
				hx-post={ "/media/" + strconv.FormatInt(m.ID, 10) + "/start" }
				hx-target="closest tr"
				hx-swap="outerHTML"
			>
				<button type="submit" class="filename-link" title={ m.Filename }>{ m.Filename }</button>
			</form>
			if m.StartCount > 0 {
				<small class="start-info">Стартирана { formatInt(m.StartCount) } пъти, последно на { formatDate(m.LastStartedAt.Time) }</small>
			}
		</td>
		<td class="folder">
			<a
				href={ templ.SafeURL("/media/" + strconv.FormatInt(m.ID, 10) + "/open-folder") }
				hx-get={ "/media/" + strconv.FormatInt(m.ID, 10) + "/open-folder" }
				hx-swap="none"
				class="folder-link"
				title={ m.FolderRelativePath }
			>{ m.FolderRelativePath }</a>
		</td>
		<td class="size">{ formatSize(m.FileSizeBytes) }</td>
		<td class="status"><span class={ "status-" + statusClass(m.CurrentStatus) }>{ statusShort(m.CurrentStatus) }</span></td>
		<td class="actions">
			<div class="actions-grid">
				<form
					action={ templ.SafeURL("/media/" + strconv.FormatInt(m.ID, 10) + "/status") }
					method="POST"
					hx-post={ "/media/" + strconv.FormatInt(m.ID, 10) + "/status" }
					hx-target="closest tr"
					hx-swap="outerHTML"
				>
					<input type="hidden" name="status" value="new"/>
					<button type="submit" class="icon-btn" title="Нова">○</button>
				</form>
				<form
					action={ templ.SafeURL("/media/" + strconv.FormatInt(m.ID, 10) + "/status") }
					method="POST"
					hx-post={ "/media/" + strconv.FormatInt(m.ID, 10) + "/status" }
					hx-target="closest tr"
					hx-swap="outerHTML"
				>
					<input type="hidden" name="status" value="started"/>
					<button type="submit" class="icon-btn" title="Стартирана">▶</button>
				</form>
				@flagButton(m.ID, "for-dnd", m.ForDnd, "За DnD", "👍")
				@flagButton(m.ID, "for-deletion", m.ForDeletion, "За изтриване", "👎")
				// Bug 30: ⚠️ is U+26A0 + U+FE0F, so it renders as a colour emoji like 👍 👎.
				@flagButton(m.ID, "wrong-subs", m.WrongSubs, "Грешни субтитри", "⚠️")
			</div>
		</td>
}

// flagButton renders a row's toggle for one of the three independent flags
// (Bug 30): a form that posts value 1 (raise) or 0 (clear) to the flag's route
// and swaps the row in place. A raised flag is highlighted.
templ flagButton(id int64, route string, raised int64, title string, icon string) {
	<form
		action={ templ.SafeURL("/media/" + strconv.FormatInt(id, 10) + "/" + route) }
		method="POST"
		hx-post={ "/media/" + strconv.FormatInt(id, 10) + "/" + route }
		hx-target="closest tr"
		hx-swap="outerHTML"
	>
		<input type="hidden" name="value" value={ toggleFlag(raised) }/>
		<button type="submit" class={ "icon-btn", templ.KV("filter-active", raised == 1) } title={ title }>{ icon }</button>
	</form>
}

templ ListPage(media []db.MediaWithStats, f Filters, folders []string) {
	<!DOCTYPE html>
	<html lang="bg">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Movie Tracker</title>
			<link rel="stylesheet" href="/static/pico.min.css"/>
			// Bug 27: htmx parses partial responses in a <template>, so the 🎲 response
			// (the OOB row first, then the flash) both swaps the row and fills #flash.
			<meta name="htmx-config" content='{"useTemplateFragments":true}'/>
			<script src="/static/htmx.min.js"></script>
			<script>
				/* Bug 26: picking a folder changes the dropdown before form.submit() leaves the
				   page, so a back/forward-cache restore would show the new folder over the old
				   list. Resetting the dropdown to the server-rendered option makes them match
				   again. No reload: reloading a bare "/" would render the newer remembered state
				   and break Back for every filter. ui_prefs keeps the newer folder until the
				   next click, like every other filter since Bug 23. */
				addEventListener("pageshow", function (e) {
					if (!e.persisted) { return; }
					var s = document.querySelector("select[name=folder]");
					var rendered = s && s.querySelector("option[selected]");
					if (rendered) { s.value = rendered.value; }
				});
			</script>
			<style>
				.top-nav { display: flex; align-items: center; gap: 0.6rem; padding: 0.05rem 0; margin-bottom: 0.5rem; border-bottom: 1px solid var(--pico-muted-border-color); flex-wrap: wrap; position: sticky; top: 0; z-index: 20; background: var(--pico-background-color, #fff); }
				.top-nav h1 { margin: 0; font-size: 1rem; flex: 0 0 auto; }
				.top-nav form { margin: 0; }
				.top-nav a, .top-nav button { margin: 0; padding: 0.1rem 0.5rem; font-size: 0.85rem; }
				.top-nav form button[type="submit"] {
					background: none !important; border: 1px solid transparent !important; box-shadow: none !important;
					color: var(--pico-color, inherit) !important; cursor: pointer; font-family: inherit; width: auto;
				}
				.top-nav form button[type="submit"]:hover {
					background: none !important; border-color: var(--pico-primary, currentColor) !important; box-shadow: none !important;
				}
				button, [type=submit], [type=button], [type=reset], [role=button],
				input, select, textarea { margin-bottom: 0; }
				figure { margin-bottom: 0; }
				.filter-btns, .sort-btns { display: inline-flex; align-items: center; gap: 0.2rem; }
				.filter-btn, .sort-btn {
					display: inline-flex; align-items: center; justify-content: center;
					width: 1.35rem; height: 1.35rem; padding: 0;
					font-size: 0.8rem; border-radius: 3px; cursor: pointer;
					text-decoration: none; line-height: 1; flex-shrink: 0;
					background: var(--pico-secondary-background, #f0f0f0);
					color: var(--pico-secondary-inverse, #333);
					border: 1px solid var(--pico-muted-border-color, #ccc);
				}
				.filter-btn:hover, .sort-btn:hover { border-color: var(--pico-primary); color: var(--pico-primary); }
				.filter-btn.filter-active, .sort-btn.filter-active {
					background: var(--pico-primary); color: var(--pico-primary-inverse, #fff);
					border-color: var(--pico-primary);
				}
				.sort-btn.filter-active { width: auto; min-width: 1.35rem; padding: 0 0.2rem; }
				.start-info { display: block; font-size: 0.7rem; color: var(--pico-muted-color); line-height: 1.2; }
				.status-new { color: var(--pico-muted-color); }
				.status-started { color: var(--pico-color-amber-500, #f59e0b); }
				table { width: 100%; table-layout: fixed; }
				td, th { vertical-align: middle; padding: 0.05rem 0.3rem; font-size: 0.85rem; line-height: 1.6rem; }
				th.filename { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
				td.filename { overflow: hidden; }
				th.folder,   td.folder   { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
				th.size,     td.size     { width: 4.5rem; white-space: nowrap; }
				th.status,   td.status   { width: 4rem; white-space: nowrap; }
				/* Bug 30: room for the five row buttons ○ ▶ 👍 👎 ⚠ (1.35rem each, 0.1rem gaps). */
				th.actions,  td.actions  { width: 7.8rem; white-space: nowrap; }
				form { display: inline; margin: 0; }
				button.filename-link {
					background: none; border: none; padding: 0;
					color: var(--pico-primary); cursor: pointer;
					text-decoration: underline; font: inherit; font-size: 0.85rem;
					text-align: left; white-space: nowrap;
					overflow: hidden; text-overflow: ellipsis;
					display: inline-block; height: 1.6rem; line-height: 1.6rem; width: 100%;
				}
				a.folder-link {
					display: inline-block; height: 1.6rem; line-height: 1.6rem; width: 100%;
					white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
					font-size: 0.85rem;
				}
				.actions-grid { display: inline-flex; flex-wrap: nowrap; gap: 0.1rem; align-items: center; }
				.actions-grid form { display: contents; }
				button.icon-btn {
					display: inline-flex; align-items: center; justify-content: center;
					width: 1.35rem; height: 1.35rem; padding: 0;
					font-size: 0.8rem; border-radius: 3px; cursor: pointer;
					text-decoration: none; line-height: 1; flex-shrink: 0;
				}
					/* Bug 22, Bug 30: a raised flag (👍 👎 ⚠) is highlighted, so a flagged
					   row is spottable at a glance. */
				td.actions .icon-btn.filter-active {
					background: var(--pico-primary); color: var(--pico-primary-inverse, #fff);
					border-color: var(--pico-primary);
				}
				@media (max-width: 768px) {
					th.size, td.size, th.folder, td.folder { display: none; }
				}
				.nav-label { font-size: 0.7rem; color: var(--pico-muted-color); align-self: center; }
				/* Bug 18 part 1: plain search field — same height as the rest of the nav bar
				   and no icons (no native search look / clear ✕ button).
				   Scoped as `.top-nav input.search-input` (specificity 0,2,1) so it wins over
				   Pico's tall `input:not([type=checkbox],...)` rule (0,1,1) which otherwise
				   forces a large height/padding. */
				.top-nav input.search-input {
					box-sizing: border-box; height: 1.35rem; min-height: 0; line-height: 1.35rem;
					margin: 0; padding: 0 0.4rem; padding-inline-start: 0.4rem;
					font-size: 0.8rem; width: 10rem;
					border-radius: 4px; --pico-form-element-spacing-vertical: 0;
					background-image: none;
					-webkit-appearance: none; appearance: none;
				}
				.top-nav input.search-input::-webkit-search-cancel-button,
				.top-nav input.search-input::-webkit-search-decoration { -webkit-appearance: none; display: none; }
				/* Bug 26: the main-folder dropdown sits among the 1.35rem filter buttons, so it
				   is shrunk like the search field. `.top-nav select.folder-select` (specificity
				   0,2,1) wins over Pico's select rules (0,1,1), which otherwise make it a tall,
				   full-width form control with a large chevron. max-width keeps one long folder
				   name from wrapping the nav (it still fits "всички папки"). */
				.top-nav select.folder-select {
					box-sizing: border-box; width: auto; max-width: 7.5rem; height: 1.35rem; min-height: 0;
					margin: 0; padding: 0 1.2rem 0 0.4rem; padding-inline-start: 0.4rem; padding-inline-end: 1.2rem;
					font-size: 0.8rem; line-height: 1; border-radius: 4px;
					background-position: center right 0.3rem; background-size: 0.7rem auto;
					--pico-form-element-spacing-vertical: 0;
				}
				.top-nav select.folder-select.filter-active {
					border-color: var(--pico-primary); color: var(--pico-primary); font-weight: 600;
				}
				.flash { font-size: 0.8rem; color: var(--pico-primary); min-height: 1rem; margin: 0.2rem 0; }
			</style>
		</head>
		<body>
			<main class="container">
				<nav class="top-nav">
					<h1>Movie Tracker</h1>
					<form method="POST" action="/scan">
						<button type="submit" class="icon-btn" title="Сканирай диска">↺</button>
					</form>
					<form id="search-form" method="GET" action="/">
						<input type="hidden" name="status" value={ f.Status }/>
						<input type="hidden" name="disk" value={ f.Disk }/>
						<input type="hidden" name="sort" value={ f.Sort }/>
						<input type="hidden" name="dir" value={ f.Dir }/>
						<input type="hidden" name="del" value={ f.Del }/>
						<input type="hidden" name="dnd" value={ f.Dnd }/>
						<input type="hidden" name="subs" value={ f.Subs }/>
						<input
							type="search"
							name="q"
							value={ f.Q }
							placeholder="търси..."
							class="search-input"
							hx-get="/"
							hx-trigger="keyup changed delay:300ms, search"
							hx-target="#media-list"
							hx-select="#media-list"
							hx-swap="outerHTML"
							hx-include="closest form"
							hx-push-url="true"
						/>
					</form>
					<span class="nav-label">филтър:</span>
					<div class="filter-btns">
						<select name="folder" form="search-form" class={ "folder-select", templ.KV("filter-active", f.Folder != "all") } title="Основна папка" autocomplete="off" onchange="this.form.submit()">
							<option value="all" selected?={ f.Folder == "all" }>всички папки</option>
							for _, folder := range folders {
								<option value={ folder } selected?={ folder == f.Folder }>{ folder }</option>
							}
						</select>
						<a href={ templ.SafeURL(f.WithStatus("all").Href()) } class={ "filter-btn", templ.KV("filter-active", f.Status == "all") } title="Всички статуси">◎</a>
						<a href={ templ.SafeURL(f.WithStatus("new").Href()) } class={ "filter-btn", templ.KV("filter-active", f.Status == "new") } title="Нова">○</a>
						<a href={ templ.SafeURL(f.WithStatus("started").Href()) } class={ "filter-btn", templ.KV("filter-active", f.Status == "started") } title="Стартирана">▶</a>
						if f.Disk == "all" {
							<a href={ templ.SafeURL(f.WithDisk("on").Href()) } class="filter-btn filter-active" title="Показват се всички (вкл. изчезнали) — кликни за само на диска">↕</a>
						} else {
							<a href={ templ.SafeURL(f.WithDisk("all").Href()) } class="filter-btn" title="Само на диска — кликни за всички">↕</a>
						}
						<a href={ templ.SafeURL(f.WithDnd(toggleFilter(f.Dnd)).Href()) } class={ "filter-btn", templ.KV("filter-active", f.Dnd == "yes") } title="За DnD">👍</a>
						<a href={ templ.SafeURL(f.WithDel(toggleFilter(f.Del)).Href()) } class={ "filter-btn", templ.KV("filter-active", f.Del == "yes") } title="За изтриване">👎</a>
						<a href={ templ.SafeURL(f.WithSubs(toggleFilter(f.Subs)).Href()) } class={ "filter-btn", templ.KV("filter-active", f.Subs == "yes") } title="Грешни субтитри">⚠️</a>
					</div>
					<span class="nav-label">сорт:</span>
					<div class="sort-btns">
						<a href={ templ.SafeURL(sortBtnHref(f, "name")) } class={ "sort-btn", templ.KV("filter-active", f.Sort == "name") } title="По азбучен ред">{ sortBtnContent("АЯ", f.Sort, f.Dir, "name") }</a>
						<a href={ templ.SafeURL(sortBtnHref(f, "path")) } class={ "sort-btn", templ.KV("filter-active", f.Sort == "path") } title="По папка/път">{ sortBtnContent("Пт", f.Sort, f.Dir, "path") }</a>
						<a href={ templ.SafeURL(sortBtnHref(f, "size")) } class={ "sort-btn", templ.KV("filter-active", f.Sort == "size") } title="По размер">{ sortBtnContent("Рз", f.Sort, f.Dir, "size") }</a>
						<a href={ templ.SafeURL(sortBtnHref(f, "last_started")) } class={ "sort-btn", templ.KV("filter-active", f.Sort == "last_started") } title="По последно стартиране">{ sortBtnContent("▶", f.Sort, f.Dir, "last_started") }</a>
						<a href={ templ.SafeURL(sortBtnHref(f, "added")) } class={ "sort-btn", templ.KV("filter-active", f.Sort == "added") } title="По дата добавяне">{ sortBtnContent("⊕", f.Sort, f.Dir, "added") }</a>
					</div>
					<form
						method="POST"
						action="/media/random-new/start"
						hx-post="/media/random-new/start"
						hx-target="#flash"
						hx-swap="innerHTML"
					>
						<input type="hidden" name="status" value={ f.Status }/>
						<input type="hidden" name="disk" value={ f.Disk }/>
						<input type="hidden" name="q" value={ f.Q }/>
						<input type="hidden" name="del" value={ f.Del }/>
						<input type="hidden" name="dnd" value={ f.Dnd }/>
						<input type="hidden" name="subs" value={ f.Subs }/>
						<input type="hidden" name="folder" value={ f.Folder }/>
						<button type="submit" class="sort-btn" title="Стартирай случаен от филтрираните">🎲</button>
					</form>
				</nav>
				<div id="flash" class="flash"></div>
				<div id="media-list">
					if len(media) == 0 {
						<p>Няма намерени медии.</p>
					} else {
						<figure>
							<table>
								<thead>
									<tr>
										<th class="filename">Файл</th>
										<th class="folder">Папка</th>
										<th class="size">Размер</th>
										<th class="status">Статус</th>
										<th class="actions">Функции</th>
									</tr>
								</thead>
								<tbody>
									for _, m := range media {
										@MediaRow(m)
									}
								</tbody>
							</table>
						</figure>
					}
				</div>
			</main>
		</body>
	</html>
}
