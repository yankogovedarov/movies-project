package templates

import (
	"strconv"

	"github.com/yankogovedarov/movie-tracker/internal/db"
)

templ ListPage(media []db.Medium) {
	<!DOCTYPE html>
	<html lang="bg">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Movie Tracker</title>
			<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.min.css"/>
			<style>
				.top-nav { display: flex; align-items: center; gap: 1rem; padding: 0.5rem 0; margin-bottom: 1rem; border-bottom: 1px solid var(--pico-muted-border-color); flex-wrap: wrap; }
				.top-nav h1 { margin: 0; font-size: 1.2rem; flex: 0 0 auto; }
				.top-nav form { margin: 0; }
				.top-nav button { margin: 0; padding: 0.3rem 0.8rem; }
				.status-new { color: var(--pico-muted-color); }
				.status-started { color: var(--pico-color-amber-500, #f59e0b); }
				.status-completed { color: var(--pico-color-green-500, #22c55e); }
				table { width: 100%; table-layout: auto; }
				td, th { vertical-align: middle; padding: 0.3rem 0.4rem; }
				th.filename, td.filename { width: 35%; }
				th.folder,   td.folder   { width: 25%; }
				th.size,     td.size     { width: 6rem; white-space: nowrap; }
				th.status,   td.status   { width: 8rem; white-space: nowrap; }
				th.actions,  td.actions  { width: 10rem; }
				td.filename, td.folder   { white-space: normal; word-break: break-word; overflow-wrap: break-word; }
				form { display: inline; margin: 0; }
				button.filename-link {
					background: none; border: none; padding: 0;
					color: var(--pico-primary); cursor: pointer;
					text-decoration: underline; font: inherit;
					text-align: left; word-break: break-word;
				}
				a.folder-link { word-break: break-word; }
				.actions-grid { display: flex; flex-wrap: wrap; gap: 0.2rem; align-items: center; }
				button.icon-btn, a.icon-btn {
					display: inline-flex; align-items: center; justify-content: center;
					width: 1.8rem; height: 1.8rem; padding: 0;
					font-size: 0.85rem; border-radius: 3px; cursor: pointer;
					text-decoration: none; line-height: 1; flex-shrink: 0;
				}
				a.icon-btn {
					background: var(--pico-secondary-background, #f0f0f0);
					color: var(--pico-secondary-inverse, #333);
					border: 1px solid var(--pico-muted-border-color, #ccc);
				}
				@media (max-width: 768px) {
					th.size, td.size, th.folder, td.folder { display: none; }
					th.filename, td.filename { width: 55%; }
				}
			</style>
		</head>
		<body>
			<main class="container">
				<nav class="top-nav">
					<h1>Movie Tracker</h1>
					<a href="/">Списък</a>
					<a href="/tree">Дърво</a>
					<form method="POST" action="/scan">
						<button type="submit">Сканирай</button>
					</form>
				</nav>
				if len(media) == 0 {
					<p>Няма намерени медии на диска.</p>
				} else {
					<figure>
						<table>
							<thead>
								<tr>
									<th class="filename">Файл</th>
									<th class="folder">Папка</th>
									<th class="size">Размер</th>
									<th class="status">Статус</th>
									<th class="actions">Функции</th>
								</tr>
							</thead>
							<tbody>
								for _, m := range media {
									<tr>
										<td class="filename">
											<form method="POST" action={ templ.SafeURL("/media/" + strconv.FormatInt(m.ID, 10) + "/start") }>
												<button type="submit" class="filename-link" title={ m.Filename }>{ m.Filename }</button>
											</form>
										</td>
										<td class="folder">
											<a href={ templ.SafeURL("/media/" + strconv.FormatInt(m.ID, 10) + "/open-folder") } class="folder-link" title={ m.FolderRelativePath }>{ m.FolderRelativePath }</a>
										</td>
										<td class="size">{ formatSize(m.FileSizeBytes) }</td>
										<td class="status"><span class={ "status-" + statusClass(m.CurrentStatus) }>{ m.CurrentStatus }</span></td>
										<td class="actions">
											<div class="actions-grid">
												<form method="POST" action={ templ.SafeURL("/media/" + strconv.FormatInt(m.ID, 10) + "/status") }>
													<input type="hidden" name="status" value="new"/>
													<button type="submit" class="icon-btn" title="Нова">○</button>
												</form>
												<form method="POST" action={ templ.SafeURL("/media/" + strconv.FormatInt(m.ID, 10) + "/status") }>
													<input type="hidden" name="status" value="started"/>
													<button type="submit" class="icon-btn" title="Стартирана">▶</button>
												</form>
												<form method="POST" action={ templ.SafeURL("/media/" + strconv.FormatInt(m.ID, 10) + "/status") }>
													<input type="hidden" name="status" value="completed_both"/>
													<button type="submit" class="icon-btn" title="Завършена (двамата)">✓</button>
												</form>
												<form method="POST" action={ templ.SafeURL("/media/" + strconv.FormatInt(m.ID, 10) + "/status") }>
													<input type="hidden" name="status" value="completed_yanko"/>
													<button type="submit" class="icon-btn" title="Завършена (Янко)">Я</button>
												</form>
												<form method="POST" action={ templ.SafeURL("/media/" + strconv.FormatInt(m.ID, 10) + "/status") }>
													<input type="hidden" name="status" value="completed_liza"/>
													<button type="submit" class="icon-btn" title="Завършена (Лиза)">Л</button>
												</form>
												<a href={ templ.SafeURL("/media/" + strconv.FormatInt(m.ID, 10)) } class="icon-btn" title="Детайли">ℹ</a>
											</div>
										</td>
									</tr>
								}
							</tbody>
						</table>
					</figure>
				}
			</main>
		</body>
	</html>
}
