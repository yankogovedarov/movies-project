package templates

import (
	"strconv"

	"github.com/yankogovedarov/movie-tracker/internal/db"
)

templ ListPage(media []db.Medium) {
	<!DOCTYPE html>
	<html lang="bg">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Movie Tracker</title>
			<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.min.css"/>
			<style>
				.status-new { color: var(--pico-muted-color); }
				.status-started { color: var(--pico-color-amber-500, #f59e0b); }
				.status-completed { color: var(--pico-color-green-500, #22c55e); }
				table { width: 100%; table-layout: fixed; }
				td, th { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; padding: 0.4rem 0.5rem; }
				th.filename, td.filename { width: 32%; }
				th.folder,   td.folder   { width: 22%; }
				th.size,     td.size     { width: 8%; }
				th.status,   td.status   { width: 14%; }
				th.actions,  td.actions  { width: 24%; white-space: normal; overflow: visible; }
				form { display: inline; margin: 0; }
				select { margin: 0; padding: 0.2rem 0.3rem; width: calc(100% - 2.5rem); }
				button.submit-compact { padding: 0.2rem 0.5rem; margin: 0 0 0 0.2rem; }
				button.filename-link {
					background: none;
					border: none;
					padding: 0;
					color: var(--pico-primary);
					cursor: pointer;
					text-decoration: underline;
					font: inherit;
					display: block;
					width: 100%;
					text-align: left;
					overflow: hidden;
					text-overflow: ellipsis;
					white-space: nowrap;
				}
				@media (max-width: 1200px) {
					th.size, td.size { display: none; }
					th.filename, td.filename { width: 38%; }
					th.folder,   td.folder   { width: 26%; }
					th.actions,  td.actions  { width: 22%; }
				}
				@media (max-width: 768px) {
					th.folder, td.folder { display: none; }
					th.filename, td.filename { width: 55%; }
					th.actions,  td.actions  { width: 30%; }
				}
			</style>
		</head>
		<body>
			<main class="container">
				<h1>Movie Tracker</h1>
				<form method="POST" action="/scan" style="margin-bottom: 1rem;">
					<button type="submit">Сканирай</button>
				</form>
				if len(media) == 0 {
					<p>Няма намерени медии на диска.</p>
				} else {
					<figure>
						<table>
							<thead>
								<tr>
									<th class="filename">Файл</th>
									<th class="folder">Папка</th>
									<th class="size">Размер</th>
									<th class="status">Статус</th>
									<th class="actions">Смени статус</th>
								</tr>
							</thead>
							<tbody>
								for _, m := range media {
									<tr>
										<td class="filename" title={ m.Filename }>
											<form method="POST" action={ templ.SafeURL("/media/" + strconv.FormatInt(m.ID, 10) + "/start") }>
												<button type="submit" class="filename-link">{ m.Filename }</button>
											</form>
										</td>
										<td class="folder" title={ m.FolderRelativePath }>{ m.FolderRelativePath }</td>
										<td class="size">{ formatSize(m.FileSizeBytes) }</td>
										<td class="status"><span class={ "status-" + statusClass(m.CurrentStatus) }>{ m.CurrentStatus }</span></td>
										<td class="actions">
											<form method="POST" action={ templ.SafeURL("/media/" + strconv.FormatInt(m.ID, 10) + "/status") }>
												<select name="status">
													<option value="new">Нова</option>
													<option value="started">Стартирана</option>
													<option value="completed_both">Завършена (двамата)</option>
													<option value="completed_yanko">Завършена (Янко)</option>
													<option value="completed_liza">Завършена (Лиза)</option>
												</select>
												<button type="submit" class="submit-compact">...</button>
											</form>
										</td>
									</tr>
								}
							</tbody>
						</table>
					</figure>
				}
			</main>
		</body>
	</html>
}
