package templates

import (
	"strconv"

	"github.com/yankogovedarov/movie-tracker/internal/db"
)

templ MediaRow(m db.MediaWithStats) {
	<tr>
		<td class="filename">
			<form
				action={ templ.SafeURL("/media/" + strconv.FormatInt(m.ID, 10) + "/start") }
				method="POST"
				hx-post={ "/media/" + strconv.FormatInt(m.ID, 10) + "/start" }
				hx-target="closest tr"
				hx-swap="outerHTML"
			>
				<button type="submit" class="filename-link" title={ m.Filename }>{ m.Filename }</button>
			</form>
			if m.StartCount > 0 {
				<small class="start-info">Стартирана { formatInt(m.StartCount) } пъти, последно на { formatDate(m.LastStartedAt.Time) }</small>
			}
		</td>
		<td class="folder">
			<a
				href={ templ.SafeURL("/media/" + strconv.FormatInt(m.ID, 10) + "/open-folder") }
				hx-get={ "/media/" + strconv.FormatInt(m.ID, 10) + "/open-folder" }
				hx-swap="none"
				class="folder-link"
				title={ m.FolderRelativePath }
			>{ m.FolderRelativePath }</a>
		</td>
		<td class="size">{ formatSize(m.FileSizeBytes) }</td>
		<td class="status"><span class={ "status-" + statusClass(m.CurrentStatus) }>{ statusShort(m.CurrentStatus) }</span></td>
		<td class="actions">
			<div class="actions-grid">
				<form
					action={ templ.SafeURL("/media/" + strconv.FormatInt(m.ID, 10) + "/status") }
					method="POST"
					hx-post={ "/media/" + strconv.FormatInt(m.ID, 10) + "/status" }
					hx-target="closest tr"
					hx-swap="outerHTML"
				>
					<input type="hidden" name="status" value="new"/>
					<button type="submit" class="icon-btn" title="Нова">○</button>
				</form>
				<form
					action={ templ.SafeURL("/media/" + strconv.FormatInt(m.ID, 10) + "/status") }
					method="POST"
					hx-post={ "/media/" + strconv.FormatInt(m.ID, 10) + "/status" }
					hx-target="closest tr"
					hx-swap="outerHTML"
				>
					<input type="hidden" name="status" value="started"/>
					<button type="submit" class="icon-btn" title="Стартирана">▶</button>
				</form>
				<form
					action={ templ.SafeURL("/media/" + strconv.FormatInt(m.ID, 10) + "/status") }
					method="POST"
					hx-post={ "/media/" + strconv.FormatInt(m.ID, 10) + "/status" }
					hx-target="closest tr"
					hx-swap="outerHTML"
				>
					<input type="hidden" name="status" value="completed_both"/>
					<button type="submit" class="icon-btn" title="Завършена (двамата)">✓</button>
				</form>
				<form
					action={ templ.SafeURL("/media/" + strconv.FormatInt(m.ID, 10) + "/status") }
					method="POST"
					hx-post={ "/media/" + strconv.FormatInt(m.ID, 10) + "/status" }
					hx-target="closest tr"
					hx-swap="outerHTML"
				>
					<input type="hidden" name="status" value="completed_yanko"/>
					<button type="submit" class="icon-btn" title="Завършена (Янко)">Я</button>
				</form>
				<form
					action={ templ.SafeURL("/media/" + strconv.FormatInt(m.ID, 10) + "/status") }
					method="POST"
					hx-post={ "/media/" + strconv.FormatInt(m.ID, 10) + "/status" }
					hx-target="closest tr"
					hx-swap="outerHTML"
				>
					<input type="hidden" name="status" value="completed_liza"/>
					<button type="submit" class="icon-btn" title="Завършена (Лиза)">Л</button>
				</form>
				<a href={ templ.SafeURL("/media/" + strconv.FormatInt(m.ID, 10)) } class="icon-btn" title="Детайли">ℹ</a>
			</div>
		</td>
	</tr>
}

templ ListPage(media []db.MediaWithStats, statusFilter string, diskFilter string, sortFilter string, dirFilter string) {
	<!DOCTYPE html>
	<html lang="bg">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Movie Tracker</title>
			<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.min.css"/>
			<script src="https://unpkg.com/htmx.org@1.9.12"></script>
			<style>
				.top-nav { display: flex; align-items: center; gap: 0.8rem; padding: 0.05rem 0; margin-bottom: 0.5rem; border-bottom: 1px solid var(--pico-muted-border-color); flex-wrap: wrap; }
				.top-nav h1 { margin: 0; font-size: 1rem; flex: 0 0 auto; }
				.top-nav form { margin: 0; }
				.top-nav a, .top-nav button { margin: 0; padding: 0.1rem 0.5rem; font-size: 0.85rem; }
				.top-nav form button[type="submit"] {
					background: none !important; border: 1px solid transparent !important; box-shadow: none !important;
					color: var(--pico-color, inherit) !important; cursor: pointer; font-family: inherit; width: auto;
				}
				.top-nav form button[type="submit"]:hover {
					background: none !important; border-color: var(--pico-primary, currentColor) !important; box-shadow: none !important;
				}
				button, [type=submit], [type=button], [type=reset], [role=button],
				input, select, textarea { margin-bottom: 0; }
				figure { margin-bottom: 0; }
				.filter-btns, .sort-btns { display: inline-flex; align-items: center; gap: 0.2rem; }
				.filter-btn, .sort-btn {
					display: inline-flex; align-items: center; justify-content: center;
					width: 1.35rem; height: 1.35rem; padding: 0;
					font-size: 0.8rem; border-radius: 3px; cursor: pointer;
					text-decoration: none; line-height: 1; flex-shrink: 0;
					background: var(--pico-secondary-background, #f0f0f0);
					color: var(--pico-secondary-inverse, #333);
					border: 1px solid var(--pico-muted-border-color, #ccc);
				}
				.filter-btn:hover, .sort-btn:hover { border-color: var(--pico-primary); color: var(--pico-primary); }
				.filter-btn.filter-active, .sort-btn.filter-active {
					background: var(--pico-primary); color: var(--pico-primary-inverse, #fff);
					border-color: var(--pico-primary);
				}
				.sort-btn.filter-active { width: auto; min-width: 1.35rem; padding: 0 0.2rem; }
				.start-info { display: block; font-size: 0.7rem; color: var(--pico-muted-color); line-height: 1.2; }
				.status-new { color: var(--pico-muted-color); }
				.status-started { color: var(--pico-color-amber-500, #f59e0b); }
				.status-completed { color: var(--pico-color-green-500, #22c55e); }
				table { width: 100%; table-layout: fixed; }
				td, th { vertical-align: middle; padding: 0.05rem 0.3rem; font-size: 0.85rem; line-height: 1.6rem; }
				th.filename { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
				td.filename { overflow: hidden; }
				th.folder,   td.folder   { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
				th.size,     td.size     { width: 4.5rem; white-space: nowrap; }
				th.status,   td.status   { width: 4rem; white-space: nowrap; }
				th.actions,  td.actions  { width: 9rem; white-space: nowrap; }
				form { display: inline; margin: 0; }
				button.filename-link {
					background: none; border: none; padding: 0;
					color: var(--pico-primary); cursor: pointer;
					text-decoration: underline; font: inherit; font-size: 0.85rem;
					text-align: left; white-space: nowrap;
					overflow: hidden; text-overflow: ellipsis;
					display: inline-block; height: 1.6rem; line-height: 1.6rem; width: 100%;
				}
				a.folder-link {
					display: inline-block; height: 1.6rem; line-height: 1.6rem; width: 100%;
					white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
					font-size: 0.85rem;
				}
				.actions-grid { display: inline-flex; flex-wrap: nowrap; gap: 0.1rem; align-items: center; }
				.actions-grid form { display: contents; }
				button.icon-btn, a.icon-btn {
					display: inline-flex; align-items: center; justify-content: center;
					width: 1.35rem; height: 1.35rem; padding: 0;
					font-size: 0.8rem; border-radius: 3px; cursor: pointer;
					text-decoration: none; line-height: 1; flex-shrink: 0;
				}
				a.icon-btn {
					background: var(--pico-secondary-background, #f0f0f0);
					color: var(--pico-secondary-inverse, #333);
					border: 1px solid var(--pico-muted-border-color, #ccc);
				}
				@media (max-width: 768px) {
					th.size, td.size, th.folder, td.folder { display: none; }
				}
			</style>
		</head>
		<body>
			<main class="container">
				<nav class="top-nav">
					<h1>Movie Tracker</h1>
					<a href="/">Списък</a>
					<a href="/tree">Дърво</a>
					<form method="POST" action="/scan">
						<button type="submit">Сканирай</button>
					</form>
					<div class="filter-btns">
						<a href={ templ.SafeURL("/?status=all&disk=" + diskFilter + "&sort=" + sortFilter + "&dir=" + dirFilter) } class={ "filter-btn", templ.KV("filter-active", statusFilter == "all") } title="Всички статуси">◎</a>
						<a href={ templ.SafeURL("/?status=new&disk=" + diskFilter + "&sort=" + sortFilter + "&dir=" + dirFilter) } class={ "filter-btn", templ.KV("filter-active", statusFilter == "new") } title="Нова">○</a>
						<a href={ templ.SafeURL("/?status=started&disk=" + diskFilter + "&sort=" + sortFilter + "&dir=" + dirFilter) } class={ "filter-btn", templ.KV("filter-active", statusFilter == "started") } title="Стартирана">▶</a>
						<a href={ templ.SafeURL("/?status=completed_both&disk=" + diskFilter + "&sort=" + sortFilter + "&dir=" + dirFilter) } class={ "filter-btn", templ.KV("filter-active", statusFilter == "completed_both") } title="Завършена от двамата">✓</a>
						<a href={ templ.SafeURL("/?status=completed_yanko&disk=" + diskFilter + "&sort=" + sortFilter + "&dir=" + dirFilter) } class={ "filter-btn", templ.KV("filter-active", statusFilter == "completed_yanko") } title="Завършена от Янко">Я</a>
						<a href={ templ.SafeURL("/?status=completed_liza&disk=" + diskFilter + "&sort=" + sortFilter + "&dir=" + dirFilter) } class={ "filter-btn", templ.KV("filter-active", statusFilter == "completed_liza") } title="Завършена от Лиза">Л</a>
						if diskFilter == "all" {
							<a href={ templ.SafeURL("/?status=" + statusFilter + "&disk=on&sort=" + sortFilter + "&dir=" + dirFilter) } class="filter-btn filter-active" title="Показват се всички (вкл. изчезнали) — кликни за само на диска">↕</a>
						} else {
							<a href={ templ.SafeURL("/?status=" + statusFilter + "&disk=all&sort=" + sortFilter + "&dir=" + dirFilter) } class="filter-btn" title="Само на диска — кликни за всички">↕</a>
						}
					</div>
					<div class="sort-btns">
						<a href={ templ.SafeURL(sortBtnHref(statusFilter, diskFilter, sortFilter, dirFilter, "name")) } class={ "sort-btn", templ.KV("filter-active", sortFilter == "name") } title="По азбучен ред">{ sortBtnContent("АЯ", sortFilter, dirFilter, "name") }</a>
						<a href={ templ.SafeURL(sortBtnHref(statusFilter, diskFilter, sortFilter, dirFilter, "path")) } class={ "sort-btn", templ.KV("filter-active", sortFilter == "path") } title="По папка/път">{ sortBtnContent("Пт", sortFilter, dirFilter, "path") }</a>
						<a href={ templ.SafeURL(sortBtnHref(statusFilter, diskFilter, sortFilter, dirFilter, "size")) } class={ "sort-btn", templ.KV("filter-active", sortFilter == "size") } title="По размер">{ sortBtnContent("Рз", sortFilter, dirFilter, "size") }</a>
						<a href={ templ.SafeURL(sortBtnHref(statusFilter, diskFilter, sortFilter, dirFilter, "last_started")) } class={ "sort-btn", templ.KV("filter-active", sortFilter == "last_started") } title="По последно стартиране">{ sortBtnContent("▶", sortFilter, dirFilter, "last_started") }</a>
						<a href={ templ.SafeURL(sortBtnHref(statusFilter, diskFilter, sortFilter, dirFilter, "added")) } class={ "sort-btn", templ.KV("filter-active", sortFilter == "added") } title="По дата добавяне">{ sortBtnContent("⊕", sortFilter, dirFilter, "added") }</a>
						<a href={ templ.SafeURL(sortBtnHref(statusFilter, diskFilter, sortFilter, dirFilter, "marked")) } class={ "sort-btn", templ.KV("filter-active", sortFilter == "marked") } title="По дата завършване">{ sortBtnContent("✓", sortFilter, dirFilter, "marked") }</a>
					</div>
					<form method="POST" action="/media/random-new/start">
						<button type="submit" class="sort-btn" title="Стартирай случаен нов филм">🎲</button>
					</form>
				</nav>
				if len(media) == 0 {
					<p>Няма намерени медии на диска.</p>
				} else {
					<figure>
						<table>
							<thead>
								<tr>
									<th class="filename">Файл</th>
									<th class="folder">Папка</th>
									<th class="size">Размер</th>
									<th class="status">Статус</th>
									<th class="actions">Функции</th>
								</tr>
							</thead>
							<tbody>
								for _, m := range media {
									@MediaRow(m)
								}
							</tbody>
						</table>
					</figure>
				}
			</main>
		</body>
	</html>
}
