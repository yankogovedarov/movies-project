package templates

import (
	"strconv"

	"github.com/yankogovedarov/movie-tracker/internal/db"
	"github.com/yankogovedarov/movie-tracker/internal/tree"
)

templ TreePage(root *tree.Node) {
	<!DOCTYPE html>
	<html lang="bg">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Movie Tracker — Дърво</title>
			<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.min.css"/>
			<style>
				.status-new { color: var(--pico-muted-color); }
				.status-started { color: var(--pico-color-amber-500, #f59e0b); }
				.status-completed { color: var(--pico-color-green-500, #22c55e); }
				details { margin-left: 1rem; }
				details > summary { cursor: pointer; font-weight: bold; list-style: none; padding: 0.3rem 0; }
				details > summary::before { content: "▶ "; font-size: 0.75rem; }
				details[open] > summary::before { content: "▼ "; }
				.tree-file { display: flex; align-items: center; gap: 0.75rem; padding: 0.2rem 0 0.2rem 1.5rem; }
				.tree-file form { display: inline; margin: 0; }
				button.filename-link {
					background: none; border: none; padding: 0;
					color: var(--pico-primary); cursor: pointer;
					text-decoration: underline; font: inherit;
				}
				select { margin: 0; padding: 0.15rem 0.3rem; font-size: 0.85rem; }
				button.submit-compact { padding: 0.15rem 0.4rem; margin: 0 0 0 0.2rem; font-size: 0.85rem; }
				nav.view-toggle { margin-bottom: 1rem; }
				nav.view-toggle a { margin-right: 1rem; }
			</style>
		</head>
		<body>
			<main class="container">
				<h1>Movie Tracker</h1>
				<nav class="view-toggle">
					<a href="/">Списък</a>
					<strong>Дърво</strong>
				</nav>
				<form method="POST" action="/scan" style="margin-bottom: 1rem;">
					<button type="submit">Сканирай</button>
				</form>
				if len(root.Children) == 0 && len(root.Files) == 0 {
					<p>Няма намерени медии на диска.</p>
				} else {
					@treeNodeComponent(root, 0)
				}
			</main>
		</body>
	</html>
}

templ treeNodeComponent(node *tree.Node, depth int) {
	if depth == 0 {
		for _, child := range node.Children {
			@treeNodeComponent(child, 1)
		}
		for _, f := range node.Files {
			@treeFileRow(f)
		}
	} else if depth == 1 {
		<details open>
			<summary>{ node.Name } <small>({ strconv.Itoa(countFiles(node)) })</small></summary>
			for _, child := range node.Children {
				@treeNodeComponent(child, depth+1)
			}
			for _, f := range node.Files {
				@treeFileRow(f)
			}
		</details>
	} else {
		<details>
			<summary>{ node.Name } <small>({ strconv.Itoa(countFiles(node)) })</small></summary>
			for _, child := range node.Children {
				@treeNodeComponent(child, depth+1)
			}
			for _, f := range node.Files {
				@treeFileRow(f)
			}
		</details>
	}
}

templ treeFileRow(m db.Medium) {
	<div class="tree-file">
		<form method="POST" action={ templ.SafeURL("/media/" + strconv.FormatInt(m.ID, 10) + "/start") }>
			<button type="submit" class="filename-link" title={ m.Filename }>{ m.Filename }</button>
		</form>
		<span class={ "status-" + statusClass(m.CurrentStatus) }>{ m.CurrentStatus }</span>
		<form method="POST" action={ templ.SafeURL("/media/" + strconv.FormatInt(m.ID, 10) + "/status") }>
			<select name="status">
				<option value="new">Нова</option>
				<option value="started">Стартирана</option>
				<option value="completed_both">Завършена (двамата)</option>
				<option value="completed_yanko">Завършена (Янко)</option>
				<option value="completed_liza">Завършена (Лиза)</option>
			</select>
			<button type="submit" class="submit-compact">...</button>
		</form>
	</div>
}

func countFiles(node *tree.Node) int {
	count := len(node.Files)
	for _, c := range node.Children {
		count += countFiles(c)
	}
	return count
}
